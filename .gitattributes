# core.autocrlf is on for this machine, which is right for the PowerShell tooling but
# fatal for anything that runs inside the Linux image: a shell script checked out with
# CRLF fails as `bad interpreter: /usr/bin/env bash^M`, and the error names the
# interpreter rather than the line endings, so it reads like a missing bash.
#
# CI checks out on Linux and would be fine either way; this protects a `docker build`
# run from the Windows working tree.

* text=auto

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf

# Server-side SQL is read by mysql inside the container.
*.sql       text eol=lf

*.ps1       text eol=crlf
