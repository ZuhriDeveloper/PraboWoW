# Copy to `.env` next to the compose file (chmod 600) and fill in.
# The .conf files are generated inside the container from these values at every start, so
# credentials never enter the repo or the image.

# GHCR namespace the CI pushes to — must be lowercase.
GHCR_PREFIX=ghcr.io/zuhrideveloper

# Pin to a specific build for a rollback: IMAGE_TAG=<commit-sha>
IMAGE_TAG=latest

# openssl rand -base64 32
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_USER=trinity

# What the client is sent to after authenticating. Must be reachable from the internet.
# If it is a domain, its DNS record has to be "DNS only" — Cloudflare's proxy is HTTP-only
# and silently breaks the game connection.
REALM_ADDRESS=wow.zuhri-dev.com
REALM_PORT=8085
REALM_ID=1

# Where the 5.2 GB of client-derived data lives on the host (see tools/upload-client-data.ps1).
DATA_PATH=/srv/renowow/data

# ── Playerbots ───────────────────────────────────────────────────────────────────────
#
# The image is built with bots compiled in (deploy/Dockerfile, ARG PRABOBOTS=1). There is
# no runtime switch to disable them -- to ship a bot-free server, rebuild the image with
# --build-arg PRABOBOTS=0.
#
# Bots are GM-only: the .bot commands require RBAC_PERM_COMMAND_GM, so ordinary players on
# this realm cannot spawn any. Revisit that before offering bots to players.
#
# Each bot is a full Player in memory and is ticked every world update, so they count
# against WORLD_MEM_LIMIT like real characters do. The per-account cap is 10, hardcoded
# in src/prabobots/bot/PlayerbotMgr.h.
#
# Log verbosity for the playerbots category: 4 = Debug (traces every .bot add), 3 = Info,
# 2 = Warn. Start at 4 while proving the deployment, then turn it down.
LOG_LEVEL_PLAYERBOTS=4

# Server rates. Same meaning as the parameters of tools/configure-server.ps1 -- keep the
# two in sync.
RATE_XP=5

# Grey and white (Poor, Normal) stay blizzlike: multiplying vendor trash fills bags
# without moving progression.
RATE_DROP_ITEM_COMMON=1

# Green and above (Uncommon through Artifact). This governs UNGROUPED loot only -- boss
# and dungeon tables are grouped, and LootGroup::Roll never consults the quality
# modifier, so raising this will NOT make bosses drop more. That needs loot-template
# edits in the database.
RATE_DROP_ITEM_QUALITY=50

# Leave at 1. The rate flag is passed into referenced templates, so items inside already
# get their own quality multiplier; raising this applies the boost twice.
RATE_DROP_ITEM_REFERENCED=1

# Gold from kills, then from quest rewards (including the gold given instead of XP at
# the level cap).
RATE_DROP_MONEY=5
RATE_QUEST_MONEY=5

# Resource caps, sized for the ~6 GB free on this host (Ragnarok, monitoring and the web
# apps are already resident). Total ceiling is 4.4 GB, leaving ~1.6 GB of headroom for the
# page cache and the other stacks' spikes.
#
# If `world` gets OOM-killed and restart-loops, RAISING this limit is the wrong move -- there
# is nothing to raise it into. Drop mmaps instead (upload-client-data.ps1 without the mmaps
# folder, then restart world): pathfinding goes off, and roughly a gigabyte comes back.
WORLD_MEM_LIMIT=3g
AUTH_MEM_LIMIT=256m
DB_MEM_LIMIT=1200m
DB_BUFFER_POOL=768M
