# Copy to `.env` next to the compose file (chmod 600) and fill in.
# The .conf files are generated inside the container from these values at every start, so
# credentials never enter the repo or the image.

# GHCR namespace the CI pushes to — must be lowercase.
GHCR_PREFIX=ghcr.io/zuhrideveloper

# Pin to a specific build for a rollback: IMAGE_TAG=<commit-sha>
IMAGE_TAG=latest

# openssl rand -base64 32
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_USER=trinity

# What the client is sent to after authenticating. Must be reachable from the internet.
# If it is a domain, its DNS record has to be "DNS only" — Cloudflare's proxy is HTTP-only
# and silently breaks the game connection.
REALM_ADDRESS=wow.renovin.co.id
REALM_PORT=8085
REALM_ID=1

# Where the 5.2 GB of client-derived data lives on the host (see tools/upload-client-data.ps1).
DATA_PATH=/srv/renowow/data

# Server rates. Same meaning as the parameters of tools/configure-server.ps1.
RATE_XP=5
RATE_DROP_ITEM=5
RATE_DROP_MONEY=5

# Resource caps, sized for the ~6 GB free on this host (Ragnarok, monitoring and the web
# apps are already resident). Total ceiling is 4.4 GB, leaving ~1.6 GB of headroom for the
# page cache and the other stacks' spikes.
#
# If `world` gets OOM-killed and restart-loops, RAISING this limit is the wrong move -- there
# is nothing to raise it into. Drop mmaps instead (upload-client-data.ps1 without the mmaps
# folder, then restart world): pathfinding goes off, and roughly a gigabyte comes back.
WORLD_MEM_LIMIT=3g
AUTH_MEM_LIMIT=256m
DB_MEM_LIMIT=1200m
DB_BUFFER_POOL=768M
